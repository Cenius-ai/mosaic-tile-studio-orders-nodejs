<% if (flash) { %>
  <div class="shell flash-wrap">
    <p class="flash flash--<%= flash.type === 'error' ? 'error' : 'success' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
      <svg class="icon" aria-hidden="true"><use href="#i-<%= flash.type === 'error' ? 'alert' : 'check' %>"></use></svg>
      <span><%= flash.message %></span>
    </p>
  </div>
<% } %>
