<%- include('../partials/head') %>
<main id="main" class="auth-main">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="wordmark-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <div>
        <p class="auth-brand-name">Mosaic Tile Studio</p>
        <p class="auth-brand-sub">Orders</p>
      </div>
    </div>

    <h1 class="auth-title">Sign in to your studio</h1>
    <p class="auth-lede">Your commissions, palettes and the glass room are waiting on the bench.</p>

    <% if (formError) { %>
      <p class="form-alert" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-alert"></use></svg>
        <span><%= formError %></span>
      </p>
    <% } %>

    <form method="post" action="/login" class="form" novalidate>
      <div class="field">
        <label for="identifier">Email or username</label>
        <input
          id="identifier"
          name="identifier"
          type="text"
          autocomplete="username"
          value="<%= values.identifier %>"
          aria-invalid="<%= errors.identifier ? 'true' : 'false' %>"
          <% if (errors.identifier) { %>aria-describedby="identifier-error"<% } %>
          autocapitalize="none"
          spellcheck="false">
        <% if (errors.identifier) { %>
          <p class="field-error" id="identifier-error"><%= errors.identifier %></p>
        <% } %>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <div class="field-with-action">
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            aria-invalid="<%= errors.password ? 'true' : 'false' %>"
            <% if (errors.password) { %>aria-describedby="password-error"<% } %>>
          <button type="button" class="btn btn-ghost btn-sm" data-password-toggle="password" aria-pressed="false">Show</button>
        </div>
        <% if (errors.password) { %>
          <p class="field-error" id="password-error"><%= errors.password %></p>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary btn-block" data-busy-label="Signing in…">Sign in</button>
    </form>

    <div class="demo-card">
      <p class="demo-label">Demo studio</p>
      <p class="demo-cred">Demo: cenius@cenius.ai / cenius</p>
      <p class="demo-note">Second studio, to show one studio never sees another’s glass: demo@mosaic.studio / mosaic123</p>
    </div>

    <p class="auth-alt">No studio account yet? <a href="/signup">Create one in a minute</a></p>
  </div>
</main>
<%- include('../partials/foot') %>
